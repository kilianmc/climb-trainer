# dependencies
node_modules/
.venv/

# build output
dist/
*.tsbuildinfo

# secrets — never commit. Anything here belongs in Vercel env vars.
.env
.env.*
!.env.example

# tooling
.vercel
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
coverage/
.DS_Store

# working notes for the in-flight PR — a round-to-round handoff and its draft PR body,
# neither of them a deliverable
.claude/pr-*-state.md
.claude/pr-*-body.md

# throwaway measurement scripts: they recompute a matrix off `generate()` to size a decision,
# and the decisions they sized are asserted by tests/ instead
.claude/*.py

# review aids regenerated on demand, not deliverables: the climbing/supplementary split of the
# library (the only place a miscategorised exercise is visible — no test can see one) and the
# round-to-round follow-up notes that go with the state file above
.claude/exercise-classification.md
.claude/pr-*-followups.md
