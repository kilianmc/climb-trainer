# Copy to .env for local development. NEVER commit .env — this repo is public.
# Real values live in Vercel env vars and the GH Actions `production` environment.
#
# .env is loaded automatically by server/settings.py (python-dotenv) for every
# entrypoint — the API, alembic, pytest, `python -m server.seed`. No --env-file flag.
# An exported environment variable always WINS over this file, and the load is skipped
# entirely on Vercel so a stray .env can never shadow production config.

# CORS allowlist. Comma-separated, exact origins. A '*' here fails at startup.
CORS_ORIGINS=http://localhost:5173,https://kilianmc.com

# Neon Postgres. TWO connection strings, and they are not interchangeable:
#
#   DATABASE_URL           the POOLED endpoint — host contains '-pooler'. The app uses
#                          this one. It is PgBouncer in transaction mode.
#   DATABASE_URL_UNPOOLED  the DIRECT endpoint — no '-pooler'. Alembic uses this one,
#                          because DDL and CREATE TYPE need a real session. Running a
#                          migration through the pooler tends to hang rather than error.
#
# Both values below are FAKE placeholders. Paste your own from the Neon dashboard into
# .env, which is gitignored — this repo is public, so a real string must never be
# committed. Keep '?sslmode=require'.
#
# QUOTE the value if it contains '&' — Neon appends '&channel_binding=require', and a
# bare '&' is a shell metacharacter. python-dotenv parses it unquoted just fine, but
# `set -a; . ./.env` (shell-sourcing) dies on it. Quoting satisfies both:
#     DATABASE_URL="postgresql://...?sslmode=require&channel_binding=require"
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Reminder: any variable named VITE_* is inlined into the client bundle at build
# time and is therefore PUBLIC. Never use that prefix for a secret.
